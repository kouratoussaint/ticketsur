# =============================================================================
# TicketSûr — Variables d'environnement (EXEMPLE, aucune valeur réelle)
# Copier en .env (ignoré par git). Ne jamais committer de vraie valeur.
# =============================================================================

# --- Application mobile (valeurs PUBLIQUES par nature, injectées via --dart-define)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<clé publishable / anon du projet>
TICKETSUR_ENV=development   # development | staging | production

# --- Tests base de données locaux (scripts/db-test.sh)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres

# --- À NE JAMAIS mettre ici ni dans l'app :
#   * clé service_role / secret key Supabase  → secrets d'environnement GitHub
#   * ticketsur_qr_hmac_key, ticketsur_qr_encryption_key → Supabase Vault uniquement
#   * keystore Android et mots de passe        → secrets d'environnement GitHub protégés
