<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus : l'écran de démarrage est dessiné par le système.
     Fond « Nuit » et repère Tikéo, en clair comme en sombre (lot 3c). -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ticketsur_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
